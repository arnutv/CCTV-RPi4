(footprint "TC4056A_BMS_Module"
	(version 20260206)
	(generator "custom")
	(layer "F.Cu")
	(descr "TC4056A (TP4056) Li-Ion Charger + BMS Protection Module. PCB 26x17mm. USB-C/Micro-USB charging input on left end. 6 through-hole solder pads in a single row at right end (2.54mm pitch). Pad order left-to-right: 1=IN+, 2=IN-, 3=B+, 4=B-, 5=OUT+, 6=OUT-. Charge: 1A, 4.2V. Protection: over-discharge ~2.4V, OCP ~3A. Verify pad order against your specific module silkscreen before soldering.")
	(tags "TC4056A TP4056 BMS li-ion charger protection module 6pin USB-C")
